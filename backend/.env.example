# ---- Runtime ----
APP_ENV=development            # development | production
LOG_LEVEL=INFO
ENABLE_API_DOCS=true

# ---- Supabase Postgres (Dashboard -> Connect -> Session pooler URI, keep ?sslmode=require) ----
# Use the password of the dedicated least-privilege role (see docs/SUPABASE_SETUP.md) in production.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_MIN=1
DB_POOL_MAX=5

# ---- Auth ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

# ---- CORS: comma separated, exact deployed frontend origin(s) only ----
CORS_ORIGINS=http://localhost:5173

# ---- Collectors ----
COLLECTORS_ENABLED=true
NSE_REFRESH_SECONDS=60          # during market hours (Mon-Fri 09:00-16:00 IST)
NSE_OFF_HOURS_REFRESH_SECONDS=900
MACRO_REFRESH_HOURS=6
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2
RBI_INFLATION_TARGET=4.0
